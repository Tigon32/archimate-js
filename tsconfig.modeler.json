{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "outDir": ".ci-modeler-build",
    "rootDir": ".",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true
  },
  "include": [
    "src/modeler/**/*.ts",
    "src/diagram-js-adapter/**/*.ts",
    "src/model-dto/**/*.ts",
    "src/language/relationship-decisions.mts",
    "src/language/relationship-semantics.mts",
    "lib/Modeler.ts",
    "lib/Viewer.ts"
  ]
}
