{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.mts",
    "src/**/*.cts",
    "src/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.mts",
    "lib/**/*.cts",
    "lib/**/*.tsx",
    "bin/**/*.ts",
    "bin/**/*.mts",
    "bin/**/*.cts",
    "bin/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.mts",
    "test/**/*.cts",
    "test/**/*.tsx",
    "index.ts",
    "index.mts",
    "index.cts",
    "index.tsx"
  ],
  "exclude": ["node_modules", "dist", "coverage", "test/fixtures", "test-results"]
}
