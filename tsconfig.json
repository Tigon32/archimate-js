{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.mts",
    "src/**/*.cts",
    "src/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.mts",
    "lib/**/*.cts",
    "lib/**/*.tsx",
    "bin/**/*.ts",
    "bin/**/*.mts",
    "bin/**/*.cts",
    "bin/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.mts",
    "test/**/*.cts",
    "test/**/*.tsx",
    "index.ts",
    "index.mts",
    "index.cts",
    "index.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "src/cli",
    "src/export",
    "test/cli",
    "test/browser/export-api.mts",
    "test/browser/theme-contrast.mts",
    "test/performance/browser-benchmark.mts",
    "test/browser/accessible-outline.mts",
    "test/smoke/package.test.mts",
    "test/smoke/packed-consumer.test.mts",
    "test/release/evidence.test.mts",
    "test/release/consumer-verification.test.mts",
    "test/release/packed-assets.test.mts",
    "test/security/codeowners.test.mts",
    "test/security/check-secrets.test.mts",
    "test/security/check-tracked-paths.test.mts",
    "test/security/supply-chain.test.mts",
    "test/unit/cli-export.test.mts",
    "test/unit/pr-drain.test.mts",
    "test/unit/local-verification-process.test.mts",
    "test/fixtures",
    "test-results"
  ]
}
