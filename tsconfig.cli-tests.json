{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node", "vitest/globals"],
    "skipLibCheck": true
  },
  "include": [
    "src/cli/**/*.mts",
    "test/cli/**/*.mts",
    "test/smoke/package.test.mts",
    "test/smoke/packed-consumer.test.mts",
    "test/release/evidence.test.mts",
    "test/unit/cli-export.test.mts",
    "test/browser/export-api.mts"
  ],
  "exclude": ["node_modules", "dist", "coverage", "test-results"]
}
