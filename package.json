{
  "name": "archimate-js",
  "version": "0.0.4",
  "description": "An ArchiMate diagrams modeler builds on diagram-js modeler engine from bpmn.io project",
  "author": {
    "name": "Vincent Boulet"
  },
  "license": "MIT",
  "archimateLanguageVersion": "3.2",
  "keywords": [
    "archimate",
    "architecture",
    "modeler",
    "modeling"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "all": "run-s test compile",
    "compile": "run-s compile:validator compile:browser",
    "compile:validator": "node test/smoke/compile-validator.mjs",
    "compile:browser": "node test/smoke/compile.mjs",
    "prepack": "npm run compile:validator",
    "lint": "eslint --no-eslintrc --config .eslintrc.release.json lib/BaseViewer.js lib/import/Importer.js lib/import/XmlPreflight.js test/release/check.mjs test/security/supply-chain.test.mjs test/smoke/packed-consumer.test.mjs test/unit/import-diagnostics.test.mjs test/unit/svg-export.test.mjs",
    "test": "run-s test:package test:security test:supply-chain test:fixtures test:typecheck test:validator-build test:packed-consumer test:unit",
    "test:package": "node test/smoke/package.test.mjs",
    "test:security": "node test/security/logger.test.mjs",
    "test:fixtures": "node test/security/scan-fixtures.mjs",
    "test:typecheck": "tsc --noEmit",
    "test:validator-build": "node test/smoke/compile-validator.mjs",
    "test:browser": "node test/browser/smoke.mjs",
    "test:unit": "vitest run --coverage.enabled --coverage.reporter=text",
    "test:supply-chain": "node test/security/supply-chain.test.mjs",
    "test:packed-consumer": "node test/smoke/packed-consumer.test.mjs",
    "release:check": "node test/release/check.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Tigon32/archimate-js"
  },
  "files": [
    "index.js",
    "THIRD_PARTY_NOTICES.md",
    "assets",
    "dist",
    "lib",
    "!.eslintrc"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./index.js",
    "./validator": {
      "types": "./dist/validator/index.d.ts",
      "import": "./dist/validator/index.js"
    }
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "^7.32.0",
    "eslint-plugin-bpmn-io": "^0.12.0",
    "eslint-plugin-import": "^2.25.2",
    "file-loader": "^6.2.0",
    "jsdom": "^30.1.1",
    "npm-run-all": "^4.1.5",
    "playwright-core": "1.63.0",
    "raw-loader": "^4.0.2",
    "typescript": "^7.0.2",
    "vitest": "5.0.1",
    "webpack": "^5.61.0"
  },
  "dependencies": {
    "archimate-font": "file:./archimate-font",
    "bpmn-font": "^0.10.0",
    "css.escape": "^1.5.1",
    "diagram-js": "^12.1.0",
    "diagram-js-direct-editing": "^2.0.0",
    "hex-and-rgba": "^2.0.0",
    "ids": "^1.0.0",
    "inherits": "^2.0.4",
    "inherits-browser": "^0.1.0",
    "mathjs": "15.2.0",
    "min-dash": "^3.8.0",
    "min-dom": "^3.1.3",
    "moddle": "^5.0.2",
    "moddle-xml": "^9.0.5",
    "object-refs": "^0.3.0",
    "saxes": "^6.0.0",
    "tiny-svg": "^2.2.2"
  }
}
